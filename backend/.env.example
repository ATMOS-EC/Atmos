# Conexão PostgreSQL (Supabase, Neon, Railway ou local)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Estação padrão para consultas
ESTACAO_PADRAO=ATMOS-01

# Origens permitidas para o CORS (separadas por vírgula)
# Deixe "*" para permitir qualquer origem (Vercel, localhost, etc.)
CORS_ORIGINS=*
